# Serviço systemd (modo usuário) para o monitor rodar sozinho e reiniciar
# automaticamente — inclusive após reboot (com linger ligado).
#
# Instalar (troque a ROTA na linha ExecStart antes!):
#   mkdir -p ~/.config/systemd/user
#   cp ~/flightzone/flightzone-monitor.service ~/.config/systemd/user/
#   nano ~/.config/systemd/user/flightzone-monitor.service   # ajuste --from/--to/--date
#   systemctl --user daemon-reload
#   systemctl --user enable --now flightzone-monitor
#   loginctl enable-linger "$USER"     # (opcional) rodar mesmo deslogado
#
# Ver logs:    journalctl --user -u flightzone-monitor -f
# Parar:       systemctl --user stop flightzone-monitor
# Desativar:   systemctl --user disable --now flightzone-monitor

[Unit]
Description=FlightZone - monitor de preço de passagem
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/gustavo/flightzone
# Uma rota:
ExecStart=/home/gustavo/flightzone/.venv/bin/python /home/gustavo/flightzone/monitor.py --from GRU --to GIG --date 2026-07-23 --interval 30 --jitter 0.25
# Várias rotas (comente a linha acima e use esta):
# ExecStart=/home/gustavo/flightzone/.venv/bin/python /home/gustavo/flightzone/monitor.py --routes-file /home/gustavo/flightzone/routes.json --interval 30
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
